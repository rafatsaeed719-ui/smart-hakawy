rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email == 'rafatsaeed719@gmail.com';
    }
    function isApproved() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }

    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      // المستخدم الجديد بيتسجل "منتظر" بس — مش هيقدر يفعّل نفسه
      allow create: if isAdmin() ||
        (signedIn() && request.auth.uid == uid && request.resource.data.status == 'pending');
      // المستخدم يقدر يحدّث إحصائياته بس من غير ما يغيّر حالته
      allow update: if isAdmin() ||
        (signedIn() && request.auth.uid == uid &&
         request.resource.data.status == resource.data.status &&
         request.resource.data.email == resource.data.email);
      allow delete: if isAdmin();

      match /sessions/{sid} {
        allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
        allow create: if signedIn() && request.auth.uid == uid && isApproved();
        allow update, delete: if isAdmin();
      }
    }

    // مفتاح الذكاء الاصطناعي: المفعّلين بس يقروه، والأدمن بس يغيّره
    match /config/{doc} {
      allow read: if isAdmin() || isApproved();
      allow write: if isAdmin();
    }
  }
}
